# Copy to .env and fill in. Never commit .env.
DATABASE_PATH=./data/yahoot.db
JWT_SECRET=dev-only-change-me-to-a-long-random-string

# Optional ports (defaults shown). SERVER_PORT must match the port the browser
# app expects — see DEV_SERVER_PORT in apps/web/src/config.ts.
SERVER_PORT=3020
WEB_PORT=3001
# Fallback CORS origin. localhost / LAN origins (192.168.x, 10.x, *.local) are
# reflected automatically; set this only for other hosts.
WEB_ORIGIN=http://localhost:3001

# The browser reaches the API/WS server at <page-host>:3020 by default (works on a
# LAN with no config). To override: set window.YAHOOT_SERVER_URL or edit
# apps/web/src/config.ts.

# --- production / container ------------------------------------------------
# PORT is injected by most hosts (Easypanel, Railway, Fly); SERVER_PORT is the
# local fallback. NODE_ENV=production tightens CORS to WEB_ORIGIN only.
# PORT=3020
# NODE_ENV=production
# AUTO_MIGRATE=1     # set 0 to skip migrations on container boot
